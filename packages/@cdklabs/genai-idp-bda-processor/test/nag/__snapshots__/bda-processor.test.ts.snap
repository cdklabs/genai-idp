                  "order": 5,
                  "type": "string",
                },
                "model_lambda_hook_arn": {
                  "default": "",
                  "dependsOn": {
                    "field": "model",
                    "value": "LambdaHook",
                  },
                  "description": "Lambda function ARN for custom inference (used when model is 'LambdaHook'). Function name must start with GENAIIDP-.",
                  "order": 6,
                  "type": "string",
