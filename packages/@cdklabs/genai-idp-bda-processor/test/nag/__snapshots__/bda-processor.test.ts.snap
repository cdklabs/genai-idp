    "BdaProcessorUnifiedUpdateSchemaConfig9C6BDE1A": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "ConfigurationTable": {
          "Ref": "EnvironmentConfigurationTableFFC21CA7",
        },
        "Schema": {
          "properties": {
            "agents": {
              "description": "Configuration for AI agents used in the system",
              "order": 9,
              "properties": {
                "chat_companion": {
                  "description": "Configuration for the chat companion agents",
                  "properties": {
                    "model_id": {
                      "default": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                      "description": "Model ID for the chat companion agents",
                      "enum": [
                        "us.amazon.nova-lite-v1:0",
                        "us.amazon.nova-pro-v1:0",
                        "us.amazon.nova-premier-v1:0",
                        "us.amazon.nova-2-lite-v1:0",
