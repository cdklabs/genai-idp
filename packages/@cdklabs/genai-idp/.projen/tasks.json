    "integ:snapshot-all": {
      "name": "integ:snapshot-all",
      "description": "update snapshot for all integration tests",
      "steps": [
        {
          "spawn": "integ:unified-processor:snapshot"
        }
      ]
    },
    "integ:unified-processor:assert": {
      "name": "integ:unified-processor:assert",
      "description": "assert the snapshot of integration test 'unified-processor'",
      "steps": [
        {
          "exec": "[ -d \"test/integ/unified-processor.integ.snapshot\" ] || (echo \"No snapshot available for integration test 'unified-processor'. Run 'projen integ:unified-processor:deploy' to capture.\" && exit 1)"
        },
        {
          "exec": "cdk synth --app \"ts-node -P tsconfig.dev.json test/integ/unified-processor.integ.ts\" --no-notices --no-version-reporting --no-asset-metadata --no-path-metadata -o test/integ/.tmp/unified-processor.integ/assert.cdk.out > /dev/null"
        },
        {
          "exec": "diff -r -x asset.* -x cdk.out -x manifest.json -x tree.json test/integ/unified-processor.integ.snapshot/ test/integ/.tmp/unified-processor.integ/assert.cdk.out/"
        }
      ]
    },
    "integ:unified-processor:deploy": {
      "name": "integ:unified-processor:deploy",
      "description": "deploy integration test 'unified-processor' and capture snapshot",
      "steps": [
        {
          "exec": "rm -fr test/integ/.tmp/unified-processor.integ/deploy.cdk.out"
        },
        {
          "exec": "cdk deploy --app \"ts-node -P tsconfig.dev.json test/integ/unified-processor.integ.ts\" --no-notices --no-version-reporting --no-asset-metadata --no-path-metadata '**' --require-approval=never -o test/integ/.tmp/unified-processor.integ/deploy.cdk.out"
        },
        {
          "exec": "rm -fr test/integ/unified-processor.integ.snapshot"
        },
        {
          "exec": "mv test/integ/.tmp/unified-processor.integ/deploy.cdk.out test/integ/unified-processor.integ.snapshot"
        },
        {
          "spawn": "integ:unified-processor:destroy"
        }
      ]
    },
    "integ:unified-processor:destroy": {
      "name": "integ:unified-processor:destroy",
      "description": "destroy integration test 'unified-processor'",
      "steps": [
        {
          "exec": "cdk destroy --app test/integ/unified-processor.integ.snapshot '**' --no-version-reporting"
        }
      ]
    },
    "integ:unified-processor:snapshot": {
      "name": "integ:unified-processor:snapshot",
      "description": "update snapshot for integration test \"unified-processor\"",
      "steps": [
        {
          "exec": "cdk synth --app \"ts-node -P tsconfig.dev.json test/integ/unified-processor.integ.ts\" --no-notices --no-version-reporting --no-asset-metadata --no-path-metadata -o test/integ/unified-processor.integ.snapshot > /dev/null"
        }
      ]
    },
    "integ:unified-processor:watch": {
      "name": "integ:unified-processor:watch",
      "description": "watch integration test 'unified-processor' (without updating snapshots)",
      "steps": [
        {
          "exec": "cdk watch --app \"ts-node -P tsconfig.dev.json test/integ/unified-processor.integ.ts\" --no-notices --no-version-reporting --no-asset-metadata --no-path-metadata '**' -o test/integ/.tmp/unified-processor.integ/deploy.cdk.out"
        }
      ]
    },
