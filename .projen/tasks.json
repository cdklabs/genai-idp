{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "exec": "yarn workspaces run build"
        }
      ]
    },
    "build:packages": {
      "name": "build:packages",
      "steps": [
        {
          "exec": "yarn workspace @cdklabs/genai-idp build"
        },
        {
          "exec": "yarn workspace @cdklabs/genai-idp-bda-processor build"
        },
        {
          "exec": "yarn workspace @cdklabs/genai-idp-bedrock-llm-processor build"
        },
        {
          "exec": "yarn workspace @cdklabs/genai-idp-sagemaker-udop-processor build"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)",
        "HEAD_COMMIT": "$(git rev-parse --short HEAD)"
      },
      "steps": [
        {
          "exec": "git checkout -B \"scratch-$HEAD_COMMIT\"",
          "name": "save current HEAD in a \"scratch-<commit>\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under a \"scratch-<commit>\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "yarn workspaces run compile"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "yarn install --check-files"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "yarn install --check-files --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "exec": "yarn workspaces run package"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from all monorepo packages",
      "env": {
        "RELEASE": "true"
      },
      "steps": [
        {
          "exec": "yarn workspaces run shx rm -rf dist"
        },
        {
          "exec": "yarn workspaces run bump"
        },
        {
          "exec": "yarn workspaces run build"
        },
        {
          "exec": "yarn workspaces run unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "run": {
      "name": "run",
      "steps": [
        {
          "exec": "yarn workspaces run",
          "receiveArgs": true
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "yarn workspaces run test"
        }
      ]
    },
    "update-upstream-sources": {
      "name": "update-upstream-sources",
      "steps": [
        {
          "exec": "bash -c '\n# Get latest release tag from GitHub API\nLATEST_TAG=$(curl -s \"https://api.github.com/repos/aws-solutions-library-samples/accelerated-intelligent-document-processing-on-aws/releases/latest\" | grep \"tag_name\" | cut -d \":\" -f 2 | tr -d \" ,\\\"\")\nif [ -z \"$LATEST_TAG\" ] || [ \"$LATEST_TAG\" = \"null\" ]; then\n  echo \"No releases found in upstream repository\"\n  exit 0\nfi\necho \"Found latest release: $LATEST_TAG\"\n\n# Clone the specific release tag\ngit clone --depth 1 --branch $LATEST_TAG https://github.com/aws-solutions-library-samples/accelerated-intelligent-document-processing-on-aws.git temp-upstream\nVERSION=$(cat temp-upstream/VERSION)\nif [[ ! $VERSION =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"Skipping sync: VERSION '\"'\"'$VERSION'\"'\"' is not in X.Y.Z format (appears to be work-in-progress)\"\n  rm -rf temp-upstream\n  exit 0\nfi\nrm -rf sources\nmv temp-upstream sources\nrm -rf sources/.git\necho \"Successfully synced release $LATEST_TAG (VERSION: $VERSION)\"\n\n# Stage the changes for git\ngit add sources\n'"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "Upgrade dependencies in all workspaces",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "exec": "npx npm-check-updates@20 --dep=dev,optional,peer,prod,bundle --upgrade --target=minor"
        },
        {
          "exec": "yarn workspaces run check-for-updates"
        },
        {
          "exec": "yarn install --check-files"
        },
        {
          "exec": "yarn upgrade"
        },
        {
          "spawn": "default"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
